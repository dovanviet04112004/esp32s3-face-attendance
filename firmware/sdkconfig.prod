# Secure Boot v2 and Flash Encryption belong to E13, not here: enabling them
# burns efuses on first flash and cannot be undone on that board.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.prod.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_COMPILER_STACK_CHECK_MODE_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_MAXIMUM_LEVEL_WARN=y
CONFIG_HEAP_POISONING_DISABLED=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=n
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=n
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
