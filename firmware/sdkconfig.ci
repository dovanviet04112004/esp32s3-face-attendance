# Builds on a runner with no board attached: keeps assertions so a broken
# invariant fails the job, and stays off the profiles that burn efuses.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.dev.csv"
CONFIG_COMPILER_OPTIMIZATION_DEBUG=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y
CONFIG_BSP_BRINGUP_CHECKS=n
CONFIG_DRV_LCD_SELFTEST=n
CONFIG_DRV_TOUCH_SELFTEST=n
CONFIG_DRV_CAMERA_SELFTEST=n
