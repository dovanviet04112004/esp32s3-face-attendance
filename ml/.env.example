# Copy to .env and fill in real values. .env is gitignored; this file is not.

# Hugging Face read token. Without it downloads still work but are rate limited.
# Create one at https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Kaggle API token, needed for the kaggle datasets (LCC-FASD). Create one at
# https://www.kaggle.com/settings -> API -> Create New Token
KAGGLE_API_TOKEN=KGAT_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
