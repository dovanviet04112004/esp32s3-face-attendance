<mxfile host="drawio" type="device"><diagram id="mot_ngay" name="mot_ngay"><mxGraphModel dx="800" dy="600" grid="1" gridSize="5" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="567" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="k" value="Máy ghi lượt&lt;br&gt;xuống flash,&lt;br&gt;gửi khi có mạng" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="-49.1" y="-36.0" width="98.3" height="72.0" as="geometry"/></mxCell><mxCell id="_2" value="Trong ngày" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="-30.6" y="-55.5" width="61.2" height="16.4" as="geometry"/></mxCell><mxCell id="r" value="Máy chủ nhận:&lt;br&gt;bỏ, lưu có nghi&lt;br&gt;vấn, giữ chờ&lt;br&gt;duyệt, hoặc tính" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="62.4" y="-36.0" width="98.3" height="72.0" as="geometry"/></mxCell><mxCell id="_4" value="Khi lượt tới" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="80.3" y="-55.5" width="62.5" height="16.4" as="geometry"/></mxCell><mxCell id="b" value="Dựng ngày hôm&lt;br&gt;qua: lượt đầu,&lt;br&gt;lượt cuối, ca,&lt;br&gt;ngày lễ, đơn" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="173.9" y="-36.0" width="98.3" height="72.0" as="geometry"/></mxCell><mxCell id="_6" value="00:30" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1