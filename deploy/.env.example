# Copy to deploy/.env and fill in. Never commit the filled copy (CLAUDE.md section 6).

# Erlang distribution cookie. Any long random string; EMQX refuses to start without one.
EMQX_NODE_COOKIE=change-me-to-a-long-random-string

# Replaces the shipped admin/public on first start (KEHOACH 7.2).
EMQX_DASHBOARD_PASSWORD=change-me

# Password for the svc-ops account. The acl grants any svc- user read on
# kiosk/+/up/# and write on kiosk/+/down/#, which is how a person watches the
# fleet without borrowing a device's own credentials (KEHOACH 7.4).
EMQX_OPS_PASSWORD=

# Postgres. The api builds DATABASE_URL from these, so backend/.env has to
# agree with them (KEHOACH 4.9).
POSTGRES_USER=kiosk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kiosk

# MinIO holds attendance photos, which KEHOACH 7.2 keeps on the server with a
# lifetime rather than on the kiosk at all.
MINIO_ROOT_USER=kiosk
MINIO_ROOT_PASSWORD=change-me-at-least-8-characters
# Only the console moves; 9000 is the api the backend speaks.
MINIO_CONSOLE_PORT=9011

# --- only docker-compose.prod.yml reads what follows ---

# The name Let's Encrypt issues for.
API_DOMAIN=api.example.com
# Which api image runs. deploy.sh rewrites this line on every deploy (KEHOACH 4.8).
API_TAG=latest
# 1 with traefik alone; 2 and rate-cloudflare once DNS goes through Cloudflare,
# together with a firewall that admits 80 and 443 from Cloudflare only (KEHOACH 7.2).
TRUST_PROXY_HOPS=1
API_RATE_MIDDLEWARE=rate-direct

# Where the browser calls from. The frontend lives on Vercel (KEHOACH 4.7).
CORS_ORIGIN=https://kiosk.vercel.app
# Where the link in a payslip or password-setup mail points: the dashboard.
APP_PUBLIC_URL=https://kiosk.vercel.app

# The api's own broker account; the acl grants any svc- user the fleet.
MQTT_USERNAME=svc-ops
# The session the broker holds kiosk messages in while api restarts (KEHOACH 7.5).
# One running api per id; must start with svc-. Empty means svc-api.
MQTT_CLIENT_ID=

# Passed straight into the api container, same meaning as in backend/.env.
JWT_ACCESS_SECRET=change-me-to-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-to-another-32-characters-value
JWT_DEVICE_SECRET=change-me-to-a-third-32-characters-value
DEVICE_BOOTSTRAP_TOKEN=change-me-per-firmware-batch
TEMPLATE_ENCRYPTION_KEY=change-me-openssl-rand-base64-32-gives-you-one=

# The company's zone: every day boundary, the 00:30 timesheet build and the morning
# reminders, and the backup box's clock (KEHOACH 9.8). Must equal the dashboard's
# NEXT_PUBLIC_APP_TIMEZONE on Vercel. Empty means Asia/Ho_Chi_Minh.
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Backups are encrypted to this public key. The box that writes them holds only
# this half; the private half lives with the repo owner (KEHOACH 9.22.2).
# Make a pair with: docker run --rm -it kiosk-backup:local age-keygen
AGE_RECIPIENT=age1qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq
BACKUP_KEEP_DAYS=30
# How long a face template survives in a backup after it is erased from the
# table. This is the number the privacy notice can state (KEHOACH 9.22.7).
BIOMETRIC_KEEP_DAYS=7
# Every ADMIN is mailed once a chain has had nothing new for this long; the
# nightly run finishes in minutes, so one missed night trips it (KEHOACH 4.8).
BACKUP_STALE_HOURS=26

# The bucket off this machine that offsite.sh copies every backup to (KEHOACH 4.8
# rule 3). The token reads and writes objects of this bucket only. Empty bucket
# copies nothing, and the watch then mails that the offsite chain is stale.
# Its lifecycle rules and lock are set on the bucket itself, not here.
OFFSITE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
OFFSITE_BUCKET=
OFFSITE_ACCESS_KEY_ID=
OFFSITE_SECRET_ACCESS_KEY=
# Another S3 store instead of R2: its rclone provider name and region.
OFFSITE_PROVIDER=Cloudflare
OFFSITE_REGION=auto

# What CI and the training machine send to publish a release; the same value
# goes into the repo's RELEASE_PUBLISH_TOKEN secret. Empty turns publishing off.
# Make one with: openssl rand -hex 32
RELEASE_PUBLISH_TOKEN=

# Outgoing mail. The api container reads these, and without MAIL_HOST every
# password-setup link and every bank-change warning is logged and dropped.
# Through a Gmail account MAIL_FROM must be that account; password links sent
# from a personal address still land in spam often. A mail service that sends
# as the MAIL_FROM domain needs its SPF and DKIM records and a _dmarc record in
# that domain's DNS, or Gmail and Outlook file every message as spam.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Nhân Lực <no-reply@cckiosk.io.vn>"
# Web push (KEHOACH 9.21.4). Empty keys turn push off without any error, so
# check them after a deploy. The public half also goes to Vercel as
# NEXT_PUBLIC_VAPID_PUBLIC_KEY. Make a pair with web-push generateVAPIDKeys().
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
