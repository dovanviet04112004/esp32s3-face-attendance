# Copy to deploy/.env and fill in. Never commit the filled copy (CLAUDE.md section 6).

# Erlang distribution cookie. Any long random string; EMQX refuses to start without one.
EMQX_NODE_COOKIE=change-me-to-a-long-random-string

# Replaces the shipped admin/public on first start (KEHOACH 7.2).
EMQX_DASHBOARD_PASSWORD=change-me
