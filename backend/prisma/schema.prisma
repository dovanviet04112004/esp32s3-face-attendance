// The kiosk tables of KEHOACH 4.6 plus the HR tables of KEHOACH 9.3. Lists the
// contracts already own stay String here, so contracts/schema stays their one
// source (KEHOACH 4.9).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  HR
  PAYROLL
  MANAGER
  EMPLOYEE
  VIEWER
}

enum ContractKind {
  PROBATION
  FIXED_TERM
  INDEFINITE
  SEASONAL
  INTERNSHIP
}

enum ContractState {
  DRAFT
  ACTIVE
  ENDED
  TERMINATED
}

enum DeviceStatus {
  PENDING
  APPROVED
  REVOKED
}

enum EnrollmentState {
  ASSIGNED
  ENROLLED
  REVOKED
}

enum CommandState {
  QUEUED
  SENT
  DONE
  REJECTED
  EXPIRED
}

enum RolloutState {
  DRAFT
  ROLLING
  PAUSED
  COMPLETED
}

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  passwordHash     String
  role             Role            @default(VIEWER)
  // Kept apart from Employee on purpose: a leaver's record has to stay for old
  // payrolls while their login has to die at once (KEHOACH 9.3).
  employeeId       Int?            @unique
  active           Boolean         @default(true)
  refreshTokenHash String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  employee         Employee?       @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  issuedCommands   DeviceCommand[]
  auditLogs        AuditLog[]
}

/**
 * One payroll and one social-insurance filing per entity (KEHOACH 9.20).
 */
model LegalEntity {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  taxCode     String?
  address     String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]
  employees   Employee[]
  holidays    Holiday[]
}

model Department {
  id            String       @id @default(uuid())
  legalEntityId String
  code          String
  name          String
  parentId      String?
  costCentre    String?
  headId        Int?
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  legalEntity   LegalEntity  @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  parent        Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      Department[] @relation("DepartmentTree")
  employees     Employee[]

  @@unique([legalEntityId, code])
  @@index([parentId])
}

model JobTitle {
  id        String     @id @default(uuid())
  code      String     @unique
  name      String
  grade     Int?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  employees Employee[]
}

model EmploymentContract {
  id           String        @id @default(uuid())
  employeeId   Int
  kind         ContractKind
  state        ContractState @default(DRAFT)
  number       String?
  startDate    DateTime      @db.Date
  // Null for an indefinite contract; a fixed term that lapses unnoticed turns
  // indefinite by law, which is what the expiry alert exists for (KEHOACH 9.18).
  endDate      DateTime?     @db.Date
  probationEnd DateTime?     @db.Date
  signedAt     DateTime?
  note         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, startDate])
  @@index([state, endDate])
  @@index([state, probationEnd])
}

model Employee {
  id                Int                  @id @default(autoincrement())
  code              String               @unique
  fullName          String
  legalEntityId     String?
  departmentId      String?
  jobTitleId        String?
  managerId         Int?
  hireDate          DateTime?            @db.Date
  leaveDate         DateTime?            @db.Date
  dateOfBirth       DateTime?            @db.Date
  personalEmail     String?
  phone             String?
  nationalId        String?
  taxCode           String?
  socialInsuranceNo String?
  bankAccount       String?
  bankName          String?
  photoUrl          String?
  active            Boolean              @default(true)
  embeddingVersion  String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  legalEntity       LegalEntity?         @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  department        Department?          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  jobTitle          JobTitle?            @relation(fields: [jobTitleId], references: [id], onDelete: Restrict)
  manager           Employee?            @relation("ReportsTo", fields: [managerId], references: [id], onDelete: SetNull)
  reports           Employee[]           @relation("ReportsTo")
  login             User?
  contracts         EmploymentContract[]
  days              AttendanceDay[]
  balances          LeaveBalance[]
  requests          Request[]
  approvals         Request[]            @relation("ApprovesRequests")
  delegatesAway     ApprovalDelegation[] @relation("DelegatesAway")
  delegatesFor      ApprovalDelegation[] @relation("DelegatesFor")
  templates         FaceTemplate[]
  enrollments       DeviceEnrollment[]
  attendance        AttendanceRecord[]
  shifts            ShiftAssignment[]

  @@index([departmentId, active])
  @@index([managerId])
  @@index([legalEntityId, active])
}

model FaceTemplate {
  id          String   @id @default(uuid())
  employeeId  Int
  templateIdx Int
  // Biometric data: encrypted at rest and never returned by a read API
  // (KEHOACH 7.5).
  embedding   Bytes
  scale       Float
  quality     Int?
  capturedAt  DateTime
  updatedAt   DateTime @updatedAt
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, templateIdx])
}

model Device {
  id            String             @id @db.VarChar(32)
  serial        String?            @unique
  name          String?
  location      String?
  status        DeviceStatus       @default(PENDING)
  tokenHash     String?
  fwVersion     String?
  modelVersion  String?
  // The server half of the convergence cursor: compared against the number
  // every heartbeat carries (KEHOACH 7.5).
  rosterVersion Int                @default(0)
  lastSeenAt    DateTime?
  online        Boolean            @default(false)
  approvedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  enrollments   DeviceEnrollment[]
  commands      DeviceCommand[]
  events        DeviceEvent[]
  attendance    AttendanceRecord[]

  @@index([status])
}

model DeviceEnrollment {
  deviceId    String          @db.VarChar(32)
  employeeId  Int
  state       EnrollmentState @default(ASSIGNED)
  templateIdx Int?
  updatedAt   DateTime        @updatedAt
  device      Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee    Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([deviceId, employeeId])
}

model DeviceCommand {
  cmdId      String       @id @db.Uuid
  deviceId   String       @db.VarChar(32)
  action     String
  payload    Json?
  issuedById String?
  expiresAt  DateTime?
  state      CommandState @default(QUEUED)
  resultNote String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  device     Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  issuedBy   User?        @relation(fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([deviceId, state])
}

model DeviceEvent {
  id            BigInt   @id @default(autoincrement())
  deviceId      String   @db.VarChar(32)
  type          String
  severity      String
  employeeId    Int?
  livenessScore Float?
  cmdId         String?  @db.Uuid
  errorCode     Int?
  message       String?
  ts            DateTime
  receivedAt    DateTime @default(now())
  device        Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, ts])
  @@index([type, ts])
}

model AttendanceRecord {
  id              BigInt   @id @default(autoincrement())
  // Decimal string, not a number: the kiosk counter is uint64, which overruns
  // both exact JSON integers and a signed BIGINT column.
  localId         String   @db.VarChar(20)
  deviceId        String   @db.VarChar(32)
  employeeId      Int
  ts              DateTime
  direction       String
  score           Float?
  livenessScore   Float?
  doorOpened      Boolean  @default(false)
  capturedOffline Boolean  @default(false)
  // The kiosk saying its own timestamp predates any NTP correction, so a
  // report can mark the row rather than quietly trust it (KEHOACH 6.2.5).
  clockUnsynced   Boolean  @default(false)
  photoUrl        String?
  createdAt       DateTime @default(now())
  device          Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([deviceId, localId])
  @@index([employeeId, ts])
  @@index([ts])
}

model Shift {
  id           String            @id @default(uuid())
  name         String            @unique
  startTime    String
  endTime      String
  graceMinutes Int               @default(0)
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  assignments  ShiftAssignment[]
}

model ShiftAssignment {
  id         String    @id @default(uuid())
  shiftId    String
  employeeId Int
  validFrom  DateTime
  validTo    DateTime?
  shift      Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([shiftId, employeeId, validFrom])
}

model Release {
  releaseId    String       @id @db.Uuid
  target       String
  version      String
  url          String
  sha256       String       @db.Char(64)
  sizeBytes    Int
  minFwVersion String?
  runId        String?
  rolloutState RolloutState @default(DRAFT)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([target, version])
}

model AuditLog {
  id      BigInt   @id @default(autoincrement())
  actorId String?
  action  String
  target  String
  meta    Json?
  ts      DateTime @default(now())
  actor   User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ts])
}

enum DayState {
  WORKED
  LEAVE
  HOLIDAY
  WEEKEND
  ABSENT
}

/**
 * One row per person per day: what payroll reads, and what keeps a report
 * from loading every punch of a month into memory (KEHOACH 9.8).
 */
model AttendanceDay {
  id                BigInt    @id @default(autoincrement())
  employeeId        Int
  date              DateTime  @db.Date
  state             DayState  @default(ABSENT)
  shiftId           String?
  firstIn           DateTime?
  lastOut           DateTime?
  workedMinutes     Int       @default(0)
  lateMinutes       Int       @default(0)
  earlyLeaveMinutes Int       @default(0)
  overtimeMinutes   Int       @default(0)
  punchCount        Int       @default(0)
  clockUnsynced     Boolean   @default(false)
  // What the device measured, kept whole when a correction lands on top, so a
  // corrected day can still show what the machine saw (KEHOACH 9.8).
  measuredMinutes   Int?
  adjustedById      String?
  adjustReason      String?
  adjustedAt        DateTime?
  builtAt           DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([date])
  @@index([employeeId, date])
}

model Holiday {
  id            String       @id @default(uuid())
  legalEntityId String?
  date          DateTime     @db.Date
  name          String
  paid          Boolean      @default(true)
  createdAt     DateTime     @default(now())
  legalEntity   LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)

  @@unique([legalEntityId, date])
  @@index([date])
}

enum RequestKind {
  LEAVE
  OVERTIME
  ATTENDANCE_FIX
  BUSINESS_TRIP
  REMOTE_WORK
}

enum RequestState {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveType {
  id           String         @id @default(uuid())
  code         String         @unique
  name         String
  paid         Boolean        @default(true)
  daysPerYear  Decimal        @default(0) @db.Decimal(5, 1)
  carryOverMax Decimal        @default(0) @db.Decimal(5, 1)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  balances     LeaveBalance[]
  requests     Request[]
}

/**
 * One row per person per type per year: a balance read is one row, not a sum
 * over the whole history, which only gets slower (KEHOACH 9.5).
 */
model LeaveBalance {
  id          String    @id @default(uuid())
  employeeId  Int
  leaveTypeId String
  year        Int
  entitled    Decimal   @default(0) @db.Decimal(5, 1)
  carriedOver Decimal   @default(0) @db.Decimal(5, 1)
  taken       Decimal   @default(0) @db.Decimal(5, 1)
  // Held by requests still waiting: without it three overlapping requests all
  // pass the check and all get approved (KEHOACH 9.5).
  pending     Decimal   @default(0) @db.Decimal(5, 1)
  updatedAt   DateTime  @updatedAt
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId, year])
}

/**
 * Leave, overtime, an attendance correction and a trip are one table: they
 * share a state machine, an inbox and a route to the approver (KEHOACH 9.5).
 */
model Request {
  id            String       @id @default(uuid())
  employeeId    Int
  kind          RequestKind
  state         RequestState @default(DRAFT)
  leaveTypeId   String?
  fromDate      DateTime     @db.Date
  toDate        DateTime     @db.Date
  fromAt        DateTime?
  toAt          DateTime?
  halfDay       Boolean      @default(false)
  days          Decimal      @default(0) @db.Decimal(5, 1)
  minutes       Int          @default(0)
  reason        String
  attachmentUrl String?
  approverId    Int?
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  employee      Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType     LeaveType?   @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  approver      Employee?    @relation("ApprovesRequests", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([employeeId, state])
  @@index([state, fromDate])
  @@index([approverId, state])
}

/**
 * A stand-in while somebody is away, so requests do not wait on one person.
 */
model ApprovalDelegation {
  id        String   @id @default(uuid())
  fromId    Int
  toId      Int
  fromDate  DateTime @db.Date
  toDate    DateTime @db.Date
  createdAt DateTime @default(now())
  delegator Employee @relation("DelegatesAway", fields: [fromId], references: [id], onDelete: Cascade)
  delegate  Employee @relation("DelegatesFor", fields: [toId], references: [id], onDelete: Cascade)

  @@index([fromId, fromDate, toDate])
}
