// The kiosk tables of KEHOACH 4.6 plus the HR tables of KEHOACH 9.3. Lists the
// contracts already own stay String here, so contracts/schema stays their one
// source (KEHOACH 4.9).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  HR
  PAYROLL
  MANAGER
  EMPLOYEE
  VIEWER
}

enum Gender {
  MALE
  FEMALE
}

enum ContractKind {
  PROBATION
  FIXED_TERM
  INDEFINITE
  SEASONAL
  INTERNSHIP
}

enum ContractState {
  DRAFT
  ACTIVE
  ENDED
  TERMINATED
}

enum DeviceStatus {
  PENDING
  APPROVED
  REVOKED
}

enum EnrollmentState {
  ASSIGNED
  ENROLLED
  REVOKED
}

enum CommandState {
  QUEUED
  SENT
  DONE
  REJECTED
  EXPIRED
}

enum RolloutState {
  DRAFT
  ROLLING
  PAUSED
  COMPLETED
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String
  role           Role            @default(VIEWER)
  // Kept apart from Employee on purpose: a leaver's record has to stay for old
  // payrolls while their login has to die at once (KEHOACH 9.3).
  employeeId     Int?            @unique
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  employee       Employee?       @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  sessions       Session[]
  passwordSetups PasswordSetup[]
  issuedCommands DeviceCommand[]
  auditLogs      AuditLog[]
  assetMoves     AssetTransfer[]
  tasksDone      ChecklistTask[]
  certificates   Certificate[]
}

/**
 * One row per device somebody is signed in on, so a second login reads as a
 * second device rather than as a theft (KEHOACH 9.23 rule 5).
 */
model Session {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

/**
 * A one-time link that lets somebody set their first password. The server
 * holds the hash; the link itself leaves once, by mail (KEHOACH 9.4).
 */
model PasswordSetup {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
}

/**
 * One payroll and one social-insurance filing per entity (KEHOACH 9.20).
 */
model LegalEntity {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  taxCode     String?
  address     String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]
  employees   Employee[]
  holidays    Holiday[]
  policies    PayrollPolicy[]
  periods     PayrollPeriod[]
}

model Department {
  id            String       @id @default(uuid())
  legalEntityId String
  code          String
  name          String
  parentId      String?
  costCentre    String?
  headId        Int?
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  legalEntity   LegalEntity  @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  parent        Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      Department[] @relation("DepartmentTree")
  employees     Employee[]

  @@unique([legalEntityId, code])
  @@index([parentId])
  checklists    ChecklistTemplate[]
}

model JobTitle {
  id        String     @id @default(uuid())
  code      String     @unique
  name      String
  grade     Int?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  employees Employee[]
  checklists   ChecklistTemplate[]
}

model EmploymentContract {
  id           String        @id @default(uuid())
  employeeId   Int
  kind         ContractKind
  state        ContractState @default(DRAFT)
  number       String?
  startDate    DateTime      @db.Date
  // Null for an indefinite contract; a fixed term that lapses unnoticed turns
  // indefinite by law, which is what the expiry alert exists for (KEHOACH 9.18).
  endDate      DateTime?     @db.Date
  probationEnd DateTime?     @db.Date
  signedAt     DateTime?
  note         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, startDate])
  @@index([state, endDate])
  @@index([state, probationEnd])
}

model Employee {
  id                Int                  @id @default(autoincrement())
  code              String               @unique
  fullName          String
  legalEntityId     String?
  departmentId      String?
  jobTitleId        String?
  managerId         Int?
  hireDate          DateTime?            @db.Date
  leaveDate         DateTime?            @db.Date
  dateOfBirth       DateTime?            @db.Date
  // Two values because the insurance form has two; unknown stays null and
  // the export leaves the cell empty rather than guessing (KEHOACH 9.19).
  gender            Gender?
  personalEmail     String?
  phone             String?
  // Mail is generated on the server, where no request carries a language.
  locale            String               @default("vi")
  nationalId        String?
  taxCode           String?
  socialInsuranceNo String?
  bankAccount       String?
  bankName          String?
  photoUrl          String?
  active            Boolean              @default(true)
  embeddingVersion  String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  legalEntity       LegalEntity?         @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  department        Department?          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  jobTitle          JobTitle?            @relation(fields: [jobTitleId], references: [id], onDelete: Restrict)
  manager           Employee?            @relation("ReportsTo", fields: [managerId], references: [id], onDelete: SetNull)
  reports           Employee[]           @relation("ReportsTo")
  login             User?
  contracts         EmploymentContract[]
  days              AttendanceDay[]
  balances          LeaveBalance[]
  requests          Request[]
  approvals         Request[]            @relation("ApprovesRequests")
  delegatesAway     ApprovalDelegation[] @relation("DelegatesAway")
  delegatesFor      ApprovalDelegation[] @relation("DelegatesFor")
  templates         FaceTemplate[]
  enrollments       DeviceEnrollment[]
  attendance        AttendanceRecord[]
  shifts            ShiftAssignment[]
  compensation      CompensationRecord[]
  dependents        Dependent[]
  payslips          Payslip[]
  retros            RetroAdjustment[]
  advances          SalaryAdvance[]
  advanceApprovals  SalaryAdvance[]      @relation("ApprovesAdvances")
  consents          BiometricConsent[]
  bonuses           BonusItem[]
  notices           Notification[]
  noticePrefs       NotificationPreference[]
  pushSubs          PushSubscription[]
  assetsHeld        Asset[]
  assetMoves        AssetTransfer[]
  certificates      Certificate[]
  checklistRuns     ChecklistRun[]
  ownedTasks        ChecklistTask[]     @relation("OwnsTasks")

  @@index([departmentId, active])
  @@index([managerId])
  @@index([legalEntityId, active])
}

model FaceTemplate {
  id          String   @id @default(uuid())
  employeeId  Int
  templateIdx Int
  // Biometric data: encrypted at rest and never returned by a read API
  // (KEHOACH 7.5).
  embedding   Bytes
  scale       Float
  quality     Int?
  capturedAt  DateTime
  updatedAt   DateTime @updatedAt
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, templateIdx])
}

model Device {
  id            String             @id @db.VarChar(32)
  serial        String?            @unique
  name          String?
  location      String?
  status        DeviceStatus       @default(PENDING)
  tokenHash     String?
  fwVersion     String?
  modelVersion  String?
  // The server half of the convergence cursor: compared against the number
  // every heartbeat carries (KEHOACH 7.5).
  rosterVersion Int                @default(0)
  lastSeenAt    DateTime?
  online        Boolean            @default(false)
  approvedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  enrollments   DeviceEnrollment[]
  commands      DeviceCommand[]
  events        DeviceEvent[]
  attendance    AttendanceRecord[]

  @@index([status])
}

model DeviceEnrollment {
  deviceId    String          @db.VarChar(32)
  employeeId  Int
  state       EnrollmentState @default(ASSIGNED)
  templateIdx Int?
  updatedAt   DateTime        @updatedAt
  device      Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee    Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([deviceId, employeeId])
}

model DeviceCommand {
  cmdId      String       @id @db.Uuid
  deviceId   String       @db.VarChar(32)
  action     String
  payload    Json?
  issuedById String?
  expiresAt  DateTime?
  state      CommandState @default(QUEUED)
  resultNote String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  device     Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  issuedBy   User?        @relation(fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([deviceId, state])
}

model DeviceEvent {
  id            BigInt   @id @default(autoincrement())
  deviceId      String   @db.VarChar(32)
  type          String
  severity      String
  employeeId    Int?
  livenessScore Float?
  cmdId         String?  @db.Uuid
  errorCode     Int?
  message       String?
  ts            DateTime
  receivedAt    DateTime @default(now())
  device        Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, ts])
  @@index([type, ts])
}

model AttendanceRecord {
  id              BigInt   @id @default(autoincrement())
  // Decimal string, not a number: the kiosk counter is uint64, which overruns
  // both exact JSON integers and a signed BIGINT column.
  localId         String   @db.VarChar(20)
  deviceId        String   @db.VarChar(32)
  employeeId      Int
  ts              DateTime
  direction       String
  score           Float?
  livenessScore   Float?
  doorOpened      Boolean  @default(false)
  capturedOffline Boolean  @default(false)
  // The kiosk saying its own timestamp predates any NTP correction, so a
  // report can mark the row rather than quietly trust it (KEHOACH 6.2.5).
  clockUnsynced   Boolean  @default(false)
  photoUrl        String?
  createdAt       DateTime @default(now())
  device          Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([deviceId, localId])
  @@index([employeeId, ts, id])
  @@index([ts, id])
}

model Shift {
  id           String            @id @default(uuid())
  name         String            @unique
  startTime    String
  endTime      String
  graceMinutes Int               @default(0)
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  assignments  ShiftAssignment[]
}

model ShiftAssignment {
  id         String    @id @default(uuid())
  shiftId    String
  employeeId Int
  validFrom  DateTime
  validTo    DateTime?
  shift      Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([shiftId, employeeId, validFrom])
}

model Release {
  releaseId    String       @id @db.Uuid
  target       String
  version      String
  url          String
  sha256       String       @db.Char(64)
  sizeBytes    Int
  minFwVersion String?
  runId        String?
  rolloutState RolloutState @default(DRAFT)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([target, version])
}

/**
 * Who did what to which thing, and when. The subject is a pair so tracing
 * runs from the object rather than from a route (KEHOACH 9.24).
 */
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorId     String?
  action      String
  subjectType String
  subjectId   String
  meta        Json?
  ts          DateTime @default(now())
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ts])
  @@index([subjectType, subjectId, ts])
  @@index([actorId, ts])
}

enum DayState {
  WORKED
  LEAVE
  HOLIDAY
  WEEKEND
  ABSENT
}

/**
 * One row per person per day: what payroll reads, and what keeps a report
 * from loading every punch of a month into memory (KEHOACH 9.8).
 */
model AttendanceDay {
  id                BigInt    @default(autoincrement())
  employeeId        Int
  date              DateTime  @db.Date
  state             DayState  @default(ABSENT)
  shiftId           String?
  firstIn           DateTime?
  lastOut           DateTime?
  workedMinutes     Int       @default(0)
  lateMinutes       Int       @default(0)
  earlyLeaveMinutes Int       @default(0)
  overtimeMinutes   Int       @default(0)
  punchCount        Int       @default(0)
  clockUnsynced     Boolean   @default(false)
  // What the device measured, kept whole when a correction lands on top, so a
  // corrected day can still show what the machine saw (KEHOACH 9.8).
  measuredMinutes   Int?
  adjustedById      String?
  adjustReason      String?
  adjustedAt        DateTime?
  builtAt           DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Partitioned by month on date, so date is in the primary key: Postgres
  // requires the partition key in every unique key (KEHOACH 9.22.3b).
  @@id([id, date])
  @@unique([employeeId, date])
  @@index([date])
  @@index([employeeId, date])
}

model Holiday {
  id            String       @id @default(uuid())
  legalEntityId String?
  date          DateTime     @db.Date
  name          String
  paid          Boolean      @default(true)
  createdAt     DateTime     @default(now())
  legalEntity   LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)

  // The index is NULLS NOT DISTINCT in the migration: two company-wide days on
  // one date are the same day, and Postgres would otherwise allow both.
  @@unique([legalEntityId, date])
  @@index([date])
}

enum RequestKind {
  LEAVE
  OVERTIME
  ATTENDANCE_FIX
  BUSINESS_TRIP
  REMOTE_WORK
}

enum CertificateKind {
  EMPLOYMENT
  INCOME
}

enum CertificateState {
  REQUESTED
  ISSUED
  REJECTED
}

enum RequestState {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveType {
  id           String         @id @default(uuid())
  code         String         @unique
  name         String
  paid         Boolean        @default(true)
  daysPerYear  Decimal        @default(0) @db.Decimal(5, 1)
  carryOverMax Decimal        @default(0) @db.Decimal(5, 1)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  balances     LeaveBalance[]
  requests     Request[]
}

/**
 * One row per person per type per year: a balance read is one row, not a sum
 * over the whole history, which only gets slower (KEHOACH 9.5).
 */
model LeaveBalance {
  id          String    @id @default(uuid())
  employeeId  Int
  leaveTypeId String
  year        Int
  entitled    Decimal   @default(0) @db.Decimal(5, 1)
  carriedOver Decimal   @default(0) @db.Decimal(5, 1)
  taken       Decimal   @default(0) @db.Decimal(5, 1)
  // Held by requests still waiting: without it three overlapping requests all
  // pass the check and all get approved (KEHOACH 9.5).
  pending     Decimal   @default(0) @db.Decimal(5, 1)
  updatedAt   DateTime  @updatedAt
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId, year])
}

/**
 * Leave, overtime, an attendance correction and a trip are one table: they
 * share a state machine, an inbox and a route to the approver (KEHOACH 9.5).
 */
/**
 * A letter somebody asks HR for, and the register of what was handed out.
 * The serial is the point: a letter nobody can trace back is not proof
 * (KEHOACH 9.17 item 5).
 */
model Certificate {
  id         String           @id @default(uuid())
  employeeId Int
  kind       CertificateKind
  state      CertificateState @default(REQUESTED)
  purpose    String
  months     Int?
  serial     String?          @unique
  issuedAt   DateTime?
  issuedById String?
  note       String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  issuedBy   User?            @relation(fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([state, createdAt])
  @@index([employeeId, createdAt])
}

model Request {
  id            String       @id @default(uuid())
  employeeId    Int
  kind          RequestKind
  state         RequestState @default(DRAFT)
  leaveTypeId   String?
  fromDate      DateTime     @db.Date
  toDate        DateTime     @db.Date
  fromAt        DateTime?
  toAt          DateTime?
  halfDay       Boolean      @default(false)
  days          Decimal      @default(0) @db.Decimal(5, 1)
  minutes       Int          @default(0)
  reason        String
  attachmentUrl String?
  approverId    Int?
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  employee      Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType     LeaveType?   @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  approver      Employee?    @relation("ApprovesRequests", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([employeeId, state])
  @@index([state, fromDate])
  @@index([approverId, state])
}

/**
 * A stand-in while somebody is away, so requests do not wait on one person.
 */
model ApprovalDelegation {
  id        String   @id @default(uuid())
  fromId    Int
  toId      Int
  fromDate  DateTime @db.Date
  toDate    DateTime @db.Date
  createdAt DateTime @default(now())
  delegator Employee @relation("DelegatesAway", fields: [fromId], references: [id], onDelete: Cascade)
  delegate  Employee @relation("DelegatesFor", fields: [toId], references: [id], onDelete: Cascade)

  @@index([fromId, fromDate, toDate])
}

enum PayReason {
  HIRE
  PROMOTION
  ANNUAL_REVIEW
  ADJUSTMENT
  TRANSFER
  OTHER
}

/**
 * Pay is dated, not a field to overwrite: a raise appends a row, so a March
 * payslip recomputed in December still uses March's figure (KEHOACH 9.6).
 */
model CompensationRecord {
  id              String                  @id @default(uuid())
  employeeId      Int
  effectiveFrom   DateTime                @db.Date
  baseSalary      Decimal                 @db.Decimal(14, 0)
  // What insurance is charged on, which many employers set below base pay.
  insuranceSalary Decimal                 @db.Decimal(14, 0)
  reason          PayReason               @default(ADJUSTMENT)
  note            String?
  createdById     String?
  createdAt       DateTime                @default(now())
  employee        Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  allowances      CompensationAllowance[]

  @@unique([employeeId, effectiveFrom])
  @@index([employeeId, effectiveFrom])
}

/**
 * One row per fixed allowance so a quarter's lunch cost is a sum, not a scan
 * through JSON (KEHOACH 9.6).
 */
model CompensationAllowance {
  id        String             @id @default(uuid())
  recordId  String
  code      String
  label     String
  amount    Decimal            @db.Decimal(14, 0)
  taxable   Boolean            @default(true)
  insurable Boolean            @default(false)
  record    CompensationRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([recordId, code])
  @@index([code])
}

enum DependentRelation {
  CHILD
  SPOUSE
  PARENT
  SIBLING
  OTHER
}

enum DependentState {
  PENDING
  ACTIVE
  REJECTED
  ENDED
}

/**
 * A dependant registered mid-year deducts from its registered month, so the
 * window is stored rather than a single flag (KEHOACH 9.7).
 */
model Dependent {
  id           String            @id @default(uuid())
  employeeId   Int
  fullName     String
  relation     DependentRelation
  dateOfBirth  DateTime?         @db.Date
  taxCode      String?
  nationalId   String?
  fromMonth    DateTime          @db.Date
  toMonth      DateTime?         @db.Date
  state        DependentState    @default(PENDING)
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  employee     Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, state])
  @@index([state, fromMonth])
}

/**
 * Deductions, contribution rates and overtime multiples as data, because they
 * change by resolution rather than by release (KEHOACH 9.7).
 */
model PayrollPolicy {
  id                         String        @id @default(uuid())
  legalEntityId              String?
  effectiveFrom              DateTime      @db.Date
  selfDeduction              Decimal       @db.Decimal(14, 0)
  dependentDeduction         Decimal       @db.Decimal(14, 0)
  // Basis points keep every rate an integer, so no rounding rides on a float.
  socialRateBp               Int
  healthRateBp               Int
  unemploymentRateBp         Int
  employerSocialRateBp       Int
  employerHealthRateBp       Int
  employerUnemploymentRateBp Int
  referenceWage              Decimal       @db.Decimal(14, 0)
  socialCapMultiple          Int           @default(20)
  regionalMinimumWage        Decimal       @db.Decimal(14, 0)
  unemploymentCapMultiple    Int           @default(20)
  standardDaysPerMonth       Decimal       @db.Decimal(5, 2)
  // Luat BHXH: fourteen or more unpaid working days in a month owes nothing.
  noContributionUnpaidDays   Int           @default(14)
  overtimeWeekdayBp          Int           @default(15000)
  overtimeWeekendBp          Int           @default(20000)
  overtimeHolidayBp          Int           @default(30000)
  nightPremiumBp             Int           @default(3000)
  note                       String?
  createdAt                  DateTime      @default(now())
  legalEntity                LegalEntity?  @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  brackets                   TaxBracket[]
  payslips                   Payslip[]

  @@unique([legalEntityId, effectiveFrom])
  @@index([effectiveFrom])
}

/**
 * One row per progressive band; the top band leaves upToAmount null.
 */
model TaxBracket {
  id         String        @id @default(uuid())
  policyId   String
  ordinal    Int
  upToAmount Decimal?      @db.Decimal(14, 0)
  rateBp     Int
  policy     PayrollPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, ordinal])
}

enum PeriodState {
  OPEN
  LOCKED
  PAID
}

/**
 * The pay month. Locking freezes its inputs, so a figure already sent to
 * somebody cannot move behind their back (KEHOACH 9.6).
 */
model PayrollPeriod {
  id            String            @id @default(uuid())
  legalEntityId String?
  year          Int
  month         Int
  state         PeriodState       @default(OPEN)
  startDate     DateTime          @db.Date
  endDate       DateTime          @db.Date
  payDate       DateTime?         @db.Date
  lockedAt      DateTime?
  lockedById    String?
  lockNote      String?
  paidAt        DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  legalEntity   LegalEntity?      @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  runs          PayrollRun[]
  payslips      Payslip[]
  retroSource   RetroAdjustment[] @relation("RetroSource")
  retroApplied  RetroAdjustment[] @relation("RetroApplied")

  @@unique([legalEntityId, year, month])
  @@index([state, year, month])
}

enum RunKind {
  REGULAR
  BONUS
  FINAL_SETTLEMENT
}

enum RunState {
  DRAFT
  RUNNING
  DONE
  FAILED
  DISCARDED
}

/**
 * One attempt at calculating a period. A period holds many, so a draft can be
 * run, read and thrown away without touching what was issued (KEHOACH 9.6).
 */
model PayrollRun {
  id            String        @id @default(uuid())
  periodId      String
  kind          RunKind       @default(REGULAR)
  state         RunState      @default(DRAFT)
  label         String?
  departmentId  String?
  startedAt     DateTime?
  finishedAt    DateTime?
  employeeCount Int           @default(0)
  doneCount     Int           @default(0)
  failedCount   Int           @default(0)
  grossTotal    Decimal       @default(0) @db.Decimal(16, 0)
  netTotal      Decimal       @default(0) @db.Decimal(16, 0)
  createdById   String?
  note          String?
  createdAt     DateTime      @default(now())
  period        PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  payslips      Payslip[]
  bonuses       BonusItem[]

  @@index([periodId, state])
}

enum PayslipState {
  DRAFT
  ISSUED
  SENT
  VIEWED
}

model Payslip {
  id                String        @id @default(uuid())
  runId             String
  periodId          String
  employeeId        Int
  policyId          String
  state             PayslipState  @default(DRAFT)
  workedDays        Decimal       @default(0) @db.Decimal(6, 2)
  paidLeaveDays     Decimal       @default(0) @db.Decimal(6, 2)
  unpaidDays        Decimal       @default(0) @db.Decimal(6, 2)
  workedMinutes     Int           @default(0)
  overtimeMinutes   Int           @default(0)
  grossPay          Decimal       @default(0) @db.Decimal(14, 0)
  taxableIncome     Decimal       @default(0) @db.Decimal(14, 0)
  insuranceEmployee Decimal       @default(0) @db.Decimal(14, 0)
  insuranceEmployer Decimal       @default(0) @db.Decimal(14, 0)
  personalIncomeTax Decimal       @default(0) @db.Decimal(14, 0)
  deductionsTotal   Decimal       @default(0) @db.Decimal(14, 0)
  netPay            Decimal       @default(0) @db.Decimal(14, 0)
  issuedAt          DateTime?
  sentAt            DateTime?
  viewedAt          DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  run               PayrollRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  period            PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee          Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  policy            PayrollPolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  lines             PayslipLine[]

  // A redelivered batch job lands on the same row rather than a second payslip.
  @@unique([runId, employeeId])
  @@index([employeeId, periodId])
  @@index([periodId, state])
}

enum LineKind {
  EARNING
  DEDUCTION
  EMPLOYER_COST
  INFO
}

/**
 * Every component is its own row, so company-wide overtime for a quarter is
 * one grouped query rather than a walk through documents (KEHOACH 9.6).
 */
model PayslipLine {
  id        String   @id @default(uuid())
  payslipId String
  ordinal   Int
  kind      LineKind
  code      String
  // Only set where the text comes from data somebody typed, such as an
  // allowance name; a standard component is named by its code (CLAUDE.md 3.1).
  label     String?
  amount    Decimal  @db.Decimal(14, 0)
  quantity  Decimal? @db.Decimal(10, 2)
  rateBp    Int?
  payslip   Payslip  @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  // Ordered, not keyed by code: two back payments for two months carry the same
  // code and are still two amounts owed.
  @@unique([payslipId, ordinal])
  @@index([code])
}

enum RetroState {
  PENDING
  APPLIED
  CANCELLED
}

/**
 * What arrived after its period locked. It is paid in a later period instead
 * of reopening one that has already been sent out (KEHOACH 9.6).
 */
model RetroAdjustment {
  id              String         @id @default(uuid())
  employeeId      Int
  sourcePeriodId  String
  appliedPeriodId String?
  code            String
  label           String?
  amount          Decimal        @db.Decimal(14, 0)
  state           RetroState     @default(PENDING)
  reason          String
  createdById     String?
  createdAt       DateTime       @default(now())
  employee        Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  sourcePeriod    PayrollPeriod  @relation("RetroSource", fields: [sourcePeriodId], references: [id], onDelete: Cascade)
  appliedPeriod   PayrollPeriod? @relation("RetroApplied", fields: [appliedPeriodId], references: [id], onDelete: SetNull)

  @@index([employeeId, state])
  @@index([state, sourcePeriodId])
}

enum AdvanceState {
  PENDING
  APPROVED
  REJECTED
  PAID
  SETTLED
  CANCELLED
}

/**
 * An advance already happens; keeping it here makes the next payslip deduct it
 * instead of somebody remembering to (KEHOACH 9.18).
 */
model SalaryAdvance {
  id           String       @id @default(uuid())
  employeeId   Int
  amount       Decimal      @db.Decimal(14, 0)
  reason       String
  state        AdvanceState @default(PENDING)
  requestedAt  DateTime     @default(now())
  approverId   Int?
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  paidAt       DateTime?
  settledAt    DateTime?
  payslipId    String?
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approver     Employee?    @relation("ApprovesAdvances", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([employeeId, state])
  @@index([state, requestedAt])
}

enum ConsentState {
  GRANTED
  WITHDRAWN
}

/**
 * Facial features are sensitive personal data under Nghi dinh 13/2023, so the
 * agreement stands apart from the employment contract and names the text that
 * was agreed to (KEHOACH 9.19).
 */
model BiometricConsent {
  id            String       @id @default(uuid())
  employeeId    Int
  noticeVersion String
  state         ConsentState @default(GRANTED)
  method        String
  grantedAt     DateTime     @default(now())
  withdrawnAt   DateTime?
  recordedById  String?
  note          String?
  employee      Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, state])
  @@index([state, grantedAt])
}

/**
 * One amount for one person in one bonus run. A one-off kept as pay would
 * become a standing salary the next month (KEHOACH 9.18).
 */
model BonusItem {
  id         String     @id @default(uuid())
  runId      String
  employeeId Int
  code       String
  label      String?
  amount     Decimal    @db.Decimal(14, 0)
  taxable    Boolean    @default(true)
  createdAt  DateTime   @default(now())
  run        PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([runId, employeeId, code])
  @@index([employeeId])
}

enum NoticeKind {
  REQUEST_DECIDED
  REQUEST_WAITING
  PAYSLIP_ISSUED
  CONTRACT_ENDING
}

enum NoticeChannel {
  IN_APP
  PUSH
  EMAIL
}

/**
 * No column here can hold a sentence or an amount, which is what keeps a
 * salary figure off a lock screen (KEHOACH 9.21.4).
 */
model Notification {
  id         String     @id @default(uuid())
  employeeId Int
  kind       NoticeKind
  requestId  String?
  periodId   String?
  payslipId  String?
  contractId String?
  daysLeft   Int?
  approved   Boolean?
  readAt     DateTime?
  createdAt  DateTime   @default(now())
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, readAt])
  @@index([employeeId, createdAt])
}

model NotificationPreference {
  employeeId Int
  kind       NoticeKind
  channel    NoticeChannel
  on         Boolean  @default(true)
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([employeeId, kind, channel])
}

/**
 * Keyed by endpoint: a phone and a laptop are two of these, and signing out on
 * one must not silence the other (KEHOACH 9.21.4).
 */
model PushSubscription {
  id         String   @id @default(uuid())
  employeeId Int
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSentAt DateTime?
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

enum AssetState {
  IN_STOCK
  ISSUED
  RETURNED
  RETIRED
  LOST
}

enum AssetCondition {
  NEW
  GOOD
  WORN
  DAMAGED
}

/**
 * What the company lends out. `holderId` is a summary of the newest transfer,
 * kept because "who has it" is asked far more often than "who has had it"
 * (KEHOACH 9.3).
 */
model Asset {
  id          String          @id @default(uuid())
  code        String          @unique
  name        String
  kind        String
  serialNo    String?
  state       AssetState      @default(IN_STOCK)
  holderId    Int?
  note        String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  holder      Employee?       @relation(fields: [holderId], references: [id], onDelete: SetNull)
  transfers   AssetTransfer[]

  @@index([state, kind])
  @@index([holderId])
}

/** One row per hand-over, in either direction: this is the history. */
model AssetTransfer {
  id         String         @id @default(uuid())
  assetId    String
  employeeId Int
  issued     Boolean
  at         DateTime       @default(now())
  condition  AssetCondition @default(GOOD)
  note       String?
  byUserId   String?
  asset      Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  byUser     User?          @relation(fields: [byUserId], references: [id], onDelete: SetNull)

  @@index([assetId, at])
  @@index([employeeId, issued])
}

enum ChecklistKind {
  ONBOARDING
  OFFBOARDING
}

enum TaskOwner {
  MANAGER
  SELF
  HR
}

/** What somebody at this job title, in this department, has to get through. */
model ChecklistTemplate {
  id           String                  @id @default(uuid())
  kind         ChecklistKind
  name         String
  jobTitleId   String?
  departmentId String?
  active       Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  jobTitle     JobTitle?               @relation(fields: [jobTitleId], references: [id], onDelete: Cascade)
  department   Department?             @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  items        ChecklistTemplateItem[]
  runs         ChecklistRun[]

  @@index([kind, active])
}

model ChecklistTemplateItem {
  id         String            @id @default(uuid())
  templateId String
  ordinal    Int
  title      String
  owner      TaskOwner         @default(HR)
  // Days from the anchor, and negative is meaningful: a pass comes back
  // before the last day, not after it (KEHOACH 9.3).
  dueDays    Int               @default(0)
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, ordinal])
}

/** One person going through one template, frozen at the moment it started. */
model ChecklistRun {
  id         String            @id @default(uuid())
  employeeId Int
  templateId String
  kind       ChecklistKind
  anchorDate DateTime          @db.Date
  startedAt  DateTime          @default(now())
  employee   Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  tasks      ChecklistTask[]

  @@unique([employeeId, kind])
  @@index([kind, startedAt])
}

model ChecklistTask {
  id         String       @id @default(uuid())
  runId      String
  ordinal    Int
  title      String
  ownerRole  TaskOwner
  ownerId    Int?
  dueOn      DateTime     @db.Date
  doneAt     DateTime?
  doneById   String?
  note       String?
  run        ChecklistRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  owner      Employee?    @relation("OwnsTasks", fields: [ownerId], references: [id], onDelete: SetNull)
  doneBy     User?        @relation(fields: [doneById], references: [id], onDelete: SetNull)

  @@unique([runId, ordinal])
  @@index([ownerId, doneAt])
  @@index([dueOn, doneAt])
}
