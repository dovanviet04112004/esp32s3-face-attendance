// The kiosk tables of KEHOACH 4.6 plus the HR tables of KEHOACH 9.3. Lists the
// contracts already own stay String here, so contracts/schema stays their one
// source (KEHOACH 4.9).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  HR
  PAYROLL
  MANAGER
  EMPLOYEE
  VIEWER
}

enum ContractKind {
  PROBATION
  FIXED_TERM
  INDEFINITE
  SEASONAL
  INTERNSHIP
}

enum ContractState {
  DRAFT
  ACTIVE
  ENDED
  TERMINATED
}

enum DeviceStatus {
  PENDING
  APPROVED
  REVOKED
}

enum EnrollmentState {
  ASSIGNED
  ENROLLED
  REVOKED
}

enum CommandState {
  QUEUED
  SENT
  DONE
  REJECTED
  EXPIRED
}

enum RolloutState {
  DRAFT
  ROLLING
  PAUSED
  COMPLETED
}

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  passwordHash     String
  role             Role            @default(VIEWER)
  // Kept apart from Employee on purpose: a leaver's record has to stay for old
  // payrolls while their login has to die at once (KEHOACH 9.3).
  employeeId       Int?            @unique
  active           Boolean         @default(true)
  refreshTokenHash String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  employee         Employee?       @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  issuedCommands   DeviceCommand[]
  auditLogs        AuditLog[]
}

/**
 * One payroll and one social-insurance filing per entity (KEHOACH 9.20).
 */
model LegalEntity {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  taxCode     String?
  address     String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]
  employees   Employee[]
}

model Department {
  id            String       @id @default(uuid())
  legalEntityId String
  code          String
  name          String
  parentId      String?
  costCentre    String?
  headId        Int?
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  legalEntity   LegalEntity  @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  parent        Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      Department[] @relation("DepartmentTree")
  employees     Employee[]

  @@unique([legalEntityId, code])
  @@index([parentId])
}

model JobTitle {
  id        String     @id @default(uuid())
  code      String     @unique
  name      String
  grade     Int?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  employees Employee[]
}

model EmploymentContract {
  id           String        @id @default(uuid())
  employeeId   Int
  kind         ContractKind
  state        ContractState @default(DRAFT)
  number       String?
  startDate    DateTime      @db.Date
  // Null for an indefinite contract; a fixed term that lapses unnoticed turns
  // indefinite by law, which is what the expiry alert exists for (KEHOACH 9.18).
  endDate      DateTime?     @db.Date
  probationEnd DateTime?     @db.Date
  signedAt     DateTime?
  note         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, startDate])
  @@index([state, endDate])
  @@index([state, probationEnd])
}

model Employee {
  id                Int                  @id @default(autoincrement())
  code              String               @unique
  fullName          String
  legalEntityId     String?
  departmentId      String?
  jobTitleId        String?
  managerId         Int?
  hireDate          DateTime?            @db.Date
  leaveDate         DateTime?            @db.Date
  dateOfBirth       DateTime?            @db.Date
  personalEmail     String?
  phone             String?
  nationalId        String?
  taxCode           String?
  socialInsuranceNo String?
  bankAccount       String?
  bankName          String?
  photoUrl          String?
  active            Boolean              @default(true)
  embeddingVersion  String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  legalEntity       LegalEntity?         @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  department        Department?          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  jobTitle          JobTitle?            @relation(fields: [jobTitleId], references: [id], onDelete: Restrict)
  manager           Employee?            @relation("ReportsTo", fields: [managerId], references: [id], onDelete: SetNull)
  reports           Employee[]           @relation("ReportsTo")
  login             User?
  contracts         EmploymentContract[]
  templates         FaceTemplate[]
  enrollments       DeviceEnrollment[]
  attendance        AttendanceRecord[]
  shifts            ShiftAssignment[]

  @@index([departmentId, active])
  @@index([managerId])
  @@index([legalEntityId, active])
}

model FaceTemplate {
  id          String   @id @default(uuid())
  employeeId  Int
  templateIdx Int
  // Biometric data: encrypted at rest and never returned by a read API
  // (KEHOACH 7.5).
  embedding   Bytes
  scale       Float
  quality     Int?
  capturedAt  DateTime
  updatedAt   DateTime @updatedAt
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, templateIdx])
}

model Device {
  id            String             @id @db.VarChar(32)
  serial        String?            @unique
  name          String?
  location      String?
  status        DeviceStatus       @default(PENDING)
  tokenHash     String?
  fwVersion     String?
  modelVersion  String?
  // The server half of the convergence cursor: compared against the number
  // every heartbeat carries (KEHOACH 7.5).
  rosterVersion Int                @default(0)
  lastSeenAt    DateTime?
  online        Boolean            @default(false)
  approvedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  enrollments   DeviceEnrollment[]
  commands      DeviceCommand[]
  events        DeviceEvent[]
  attendance    AttendanceRecord[]

  @@index([status])
}

model DeviceEnrollment {
  deviceId    String          @db.VarChar(32)
  employeeId  Int
  state       EnrollmentState @default(ASSIGNED)
  templateIdx Int?
  updatedAt   DateTime        @updatedAt
  device      Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee    Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([deviceId, employeeId])
}

model DeviceCommand {
  cmdId      String       @id @db.Uuid
  deviceId   String       @db.VarChar(32)
  action     String
  payload    Json?
  issuedById String?
  expiresAt  DateTime?
  state      CommandState @default(QUEUED)
  resultNote String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  device     Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  issuedBy   User?        @relation(fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([deviceId, state])
}

model DeviceEvent {
  id            BigInt   @id @default(autoincrement())
  deviceId      String   @db.VarChar(32)
  type          String
  severity      String
  employeeId    Int?
  livenessScore Float?
  cmdId         String?  @db.Uuid
  errorCode     Int?
  message       String?
  ts            DateTime
  receivedAt    DateTime @default(now())
  device        Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, ts])
  @@index([type, ts])
}

model AttendanceRecord {
  id              BigInt   @id @default(autoincrement())
  // Decimal string, not a number: the kiosk counter is uint64, which overruns
  // both exact JSON integers and a signed BIGINT column.
  localId         String   @db.VarChar(20)
  deviceId        String   @db.VarChar(32)
  employeeId      Int
  ts              DateTime
  direction       String
  score           Float?
  livenessScore   Float?
  doorOpened      Boolean  @default(false)
  capturedOffline Boolean  @default(false)
  // The kiosk saying its own timestamp predates any NTP correction, so a
  // report can mark the row rather than quietly trust it (KEHOACH 6.2.5).
  clockUnsynced   Boolean  @default(false)
  photoUrl        String?
  createdAt       DateTime @default(now())
  device          Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([deviceId, localId])
  @@index([employeeId, ts])
  @@index([ts])
}

model Shift {
  id           String            @id @default(uuid())
  name         String            @unique
  startTime    String
  endTime      String
  graceMinutes Int               @default(0)
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  assignments  ShiftAssignment[]
}

model ShiftAssignment {
  id         String    @id @default(uuid())
  shiftId    String
  employeeId Int
  validFrom  DateTime
  validTo    DateTime?
  shift      Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([shiftId, employeeId, validFrom])
}

model Release {
  releaseId    String       @id @db.Uuid
  target       String
  version      String
  url          String
  sha256       String       @db.Char(64)
  sizeBytes    Int
  minFwVersion String?
  runId        String?
  rolloutState RolloutState @default(DRAFT)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([target, version])
}

model AuditLog {
  id      BigInt   @id @default(autoincrement())
  actorId String?
  action  String
  target  String
  meta    Json?
  ts      DateTime @default(now())
  actor   User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ts])
}
