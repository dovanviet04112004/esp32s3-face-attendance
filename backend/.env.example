# Copy to backend/.env and fill in. Never commit the filled copy (CLAUDE.md section 6).
# Every name here is checked by src/config/env.schema.ts at boot; a missing one
# stops the api with a message instead of surfacing as undefined hours later.

NODE_ENV=development
PORT=3000

# Must name the same user, password and database as deploy/.env (KEHOACH 4.9).
DATABASE_URL=postgresql://kiosk:change-me@127.0.0.1:5432/kiosk?schema=public
REDIS_URL=redis://127.0.0.1:6379

# 32 characters or more; two different values, not one reused twice.
JWT_ACCESS_SECRET=change-me-to-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-to-another-32-characters-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# A kiosk token lasts 90 days and rotates with 7 left (KEHOACH 7.2). Its own
# secret, because a stolen device token must not open the web session path.
DEVICE_TOKEN_TTL_DAYS=90
JWT_DEVICE_SECRET=change-me-to-a-third-32-characters-value

# Throttle on POST /auth/login (KEHOACH 7.2).
LOGIN_ATTEMPTS_PER_MINUTE=5

# How many devices one account stays signed in on; the oldest row goes when a
# login passes this (KEHOACH 9.23 rule 5).
SESSIONS_PER_USER=10

# Throttle on POST /devices/register, per address. Its own number because a
# kiosk polls it every DEVICE_POLL_INTERVAL_S while it waits for approval, and
# several may wait behind one NAT (KEHOACH 7.2).
DEVICE_REGISTER_ATTEMPTS_PER_MINUTE=60
# Proxies in front of api. 0 on a laptop; 1 behind traefik, 2 with Cloudflare ahead of it,
# or every client shares one limit (KEHOACH 4.8).
TRUST_PROXY_HOPS=0
# Every route, per signed-in account and per address before sign-in; and the tighter bucket
# for exports, imports and payroll runs (KEHOACH 7.2).
API_REQUESTS_PER_MINUTE=600
HEAVY_REQUESTS_PER_MINUTE=20
# Misses on one email in a row before it locks, and for how many minutes (KEHOACH 7.2).
LOGIN_LOCK_AFTER=10
LOGIN_LOCK_MINUTES=15

# How many logins one call to /users/provision opens. No password is hashed on
# this path, so this bounds the size of one statement, not its time (KEHOACH 9.4).
PROVISION_BATCH=2000

# How many setup links one caller may ask for in an hour. Counted by the hour
# rather than the minute because every one of them sends a letter (KEHOACH 9.4).
FORGOT_ATTEMPTS_PER_HOUR=5

# How long the one-time link in the invitation mail stays good for.
PASSWORD_SETUP_TTL_HOURS=72

# The largest image any target partition can hold, from firmware/partitions.prod.csv:
# models_0 is 0x300000. An image past this cannot be flashed, so the server
# refuses it rather than offering a kiosk something that will not fit.
OTA_MAX_BYTES=3145728

# How long the server waits while it reads a release to measure it.
OTA_FETCH_TIMEOUT_MS=60000

# How long payroll has to answer a disputed payslip. Past it, the dispute
# shows up in the checklist of the next period (KEHOACH 9.17 item 11).
DISPUTE_ANSWER_DAYS=5

# Which biometric notice text is on offer. It is stamped onto every consent
# record, so raising it after the text changes keeps old agreements pointing
# at the wording they actually agreed to (KEHOACH 9.19).
BIOMETRIC_NOTICE_VERSION=2026-01-v1

# Only the seed reads this, and it refuses to run without it. The api never
# needs it, which is why it is optional in env.schema.ts.
SEED_ADMIN_PASSWORD=change-me-before-seeding

# 32 bytes, base64. Face templates are biometric data and are sealed with this
# before they reach a row (KEHOACH 7.5). Losing it makes every stored template
# unreadable, and the kiosks have to enrol everyone again.
#   openssl rand -base64 32
TEMPLATE_ENCRYPTION_KEY=change-me-openssl-rand-base64-32-gives-you-one=

# Where a fault is announced. Leave it empty and the queue logs instead, which
# is what a machine with nobody to tell should do.
NOTIFY_WEBHOOK_URL=
# Shared by a firmware batch, so it opens POST /devices/register and nothing
# else (KEHOACH 7.3).
DEVICE_BOOTSTRAP_TOKEN=change-me-per-firmware-batch
# Wrong claim codes an admin may type before the kiosk must show a new one (KEHOACH 7.3).
DEVICE_CLAIM_ATTEMPTS=5
# Seconds a pending kiosk waits between asks; the 202 tells it (KEHOACH 7.3).
DEVICE_POLL_INTERVAL_S=5

# Comma separated. The Vercel deployment origin in production.
CORS_ORIGIN=http://localhost:3001

# Decides which local day a punch lands in and where a shift's clock sits.
APP_TIMEZONE=Asia/Ho_Chi_Minh

MQTT_URL=mqtts://127.0.0.1:8883
MQTT_USERNAME=svc-ops
MQTT_PASSWORD=change-me
MQTT_CA_CERT_PATH=../deploy/emqx/certs/ca.crt
# The broker's REST api, to close a revoked kiosk's session; the dashboard
# login of deploy/.env (KEHOACH 7.4). Required in production.
EMQX_API_URL=http://127.0.0.1:18083/api/v5
EMQX_API_USERNAME=admin
EMQX_API_PASSWORD=change-me

# Payslip mail. No MAIL_HOST means delivery logs and stops, rather than failing.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com

# Where the link in a payslip mail points; the portal asks for a login there.
APP_PUBLIC_URL=http://localhost:3001

# Web push. Generate a pair once with `npx web-push generate-vapid-keys`.
# No public key means push is off; the in-app bell still works.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@example.com
