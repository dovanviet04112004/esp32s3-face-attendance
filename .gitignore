build/
dist/
.next/
node_modules/
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── Firmware ──
firmware/build/
# idf.py -B <dir> cho profile khac; sinh ra lai duoc tai cho
firmware/build_*/
firmware/sdkconfig
firmware/sdkconfig.old
firmware/managed_components/
