# ── ml/artifacts — mọi thứ trừ khung thư mục ──
/ml/artifacts/**
!/ml/artifacts/**/
!/ml/artifacts/**/.gitkeep

# ── ml/data — chỉ giữ README, splits, manifest (§4.4.1) ──
/ml/data/**
!/ml/data/**/
!/ml/data/**/.gitkeep
!/ml/data/README.md
!/ml/data/**/manifest.yaml
!/ml/data/**/manifest.csv
!/ml/data/splits/**

# ── contracts/golden — BẮT BUỘC commit dù là .npz (§4.3) ──
!/contracts/golden/**/*.npz

# ── hardware — KiCad vào git, PDF của hãng thì không (§4.1) ──
/hardware/datasheets/**
!/hardware/datasheets/INDEX.md
/hardware/vendor/**
!/hardware/vendor/UPSTREAM.md
*.kicad_prl
*-backups/
fp-info-cache
~*.lck
_autosave-*
.history/
hardware/export/*.rpt

# ── Notebook: commit .ipynb nhưng không commit output ──
.ipynb_checkpoints/

# ── Bí mật (§6) ──
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/
# Sinh bằng deploy/emqx/gen_certs.sh; khoá riêng không bao giờ rời máy dựng
deploy/emqx/certs/
