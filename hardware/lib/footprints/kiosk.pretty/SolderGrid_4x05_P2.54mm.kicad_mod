(footprint "SolderGrid_4x05_P2.54mm"
	(version 20260206)
	(generator "kiosk-gen")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "Bare 4x5 field of 2.54 mm holes for soldering a small breakout down. No pad carries a net and none ever should: the board it holds has no standard pin row, so the module slides until its pins sit over holes and is soldered wherever they land. Power reaches the module on wire, from the pair of holes beside this field.")
