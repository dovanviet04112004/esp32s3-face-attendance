# Copy to frontend/.env.local. Every NEXT_PUBLIC_ name is compiled into the
# bundle a browser downloads, so nothing secret belongs here (KEHOACH 4.7).
NEXT_PUBLIC_API_URL=http://127.0.0.1:3000
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:3000

# Public by design: it only lets a browser subscribe, never send.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
